{
  "name": "scaled Schedule",
  "short_name": "Schedule",
  "description": "A free, open-source project scheduler with Gantt charts, critical path, resources, and Microsoft Project, Primavera P6 and Jira files.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EEF4FA",
  "theme_color": "#0B6BCB",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/x-scaled-schedule": [".sched"] },
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ]
}
